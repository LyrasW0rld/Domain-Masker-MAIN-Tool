{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "description": "Client-side tool to pseudonymize and restore domains in texts and files.",
  "author": "Domain Masker",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "build:export": "next build",
    "build:electron": "next build && electron-builder",
    "package": "electron-builder",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-serve": "^3.0.1",
    "glob": "^13.0.6",
    "jszip": "^3.10.2",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^14.2.15",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.3.1",
    "tldts": "^7.4.12",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.domainmasker.app",
    "productName": "Domain Masker",
    "directories": {
      "output": "dist-electron"
    },
    "icon": "logo.png",
    "files": [
      "out/**/*",
      "main.js"
    ],
    "extraResources": [
      {
        "from": "public/not_mask_urls.txt",
        "to": "not_mask_urls.txt"
      }
    ],
    "win": {
      "target": [
        "portable",
        "dir"
      ]
    }
  }
}
